/** Read-only readiness check. Run this before the creation function. */
function SNC_SyntheticFixturePreflight_TEST() {
  var gate = sncSFR_validateEnvironment_TEST_();
  var report = {
    runner:'SNC_SyntheticFixtureRunner_TEST',
    version:SNC_SFR_CONFIG_TEST.VERSION,
    mode:'READ_ONLY_FIXTURE_PREFLIGHT',
    evidenceLevel:'READ_ONLY_TEST_DATA_INSPECTION',
    writesExpected:0,
    externalCallsExpected:0,
    status:'BLOCKED',
    checks:[]
  };
  report.checks.push({id:'ENV-01',status:gate.ok?'PASS':'BLOCKED',detail:gate.ok?'Exact TEST environment and spreadsheet identity verified.':gate.reason});
  if (!gate.ok) {
    Logger.log('SNC_SYNTHETIC_FIXTURE_PREFLIGHT='+JSON.stringify(report));
    return report;
  }

  var props=PropertiesService.getScriptProperties();
  var existingManifest=String(props.getProperty(SNC_SFR_CONFIG_TEST.MANIFEST_PROPERTY)||'').trim();
  report.checks.push({id:'MANIFEST-01',status:existingManifest?'BLOCKED':'PASS',detail:existingManifest?'A prior fixture manifest exists; do not create another batch.':'No prior fixture manifest is stored.'});

  var ss=SpreadsheetApp.getActiveSpreadsheet();
  var users=rowsAsObjects_(ss.getSheetByName('Users'));
  var studentIds=SNC_SFR_CONFIG_TEST.STUDENTS.map(function(x){return x.studentId;});
  var collisions=users.filter(function(u){return studentIds.indexOf(String(u.StudentID||''))>=0;}).length;
  report.checks.push({id:'STUDENT-ID-01',status:collisions===0?'PASS':'BLOCKED',detail:collisions===0?'All six reserved synthetic StudentIDs are unused.':'One or more reserved StudentIDs already exist; no writes are permitted.'});

  var courseCodes=rowsAsObjects_(ss.getSheetByName('Courses')).map(function(x){return String(x.CourseCode||'').toUpperCase();});
  var courseFree=courseCodes.indexOf(SNC_SFR_CONFIG_TEST.COURSE_CODE)===-1;
  report.checks.push({id:'COURSE-CODE-01',status:courseFree?'PASS':'BLOCKED',detail:courseFree?'Reserved synthetic CourseCode is unused.':'Reserved synthetic CourseCode already exists.'});

  var semesterRows=rowsAsObjects_(ss.getSheetByName('Semesters'));
  var semesterFree=!semesterRows.some(function(x){return Number(x.AcademicYear)===SNC_SFR_CONFIG_TEST.ACADEMIC_YEAR&&String(x.Term)===SNC_SFR_CONFIG_TEST.SEMESTER_TERM;});
  report.checks.push({id:'SEMESTER-01',status:semesterFree?'PASS':'BLOCKED',detail:semesterFree?'Reserved synthetic semester key is unused.':'Reserved synthetic semester key already exists.'});

  var admins=rowsAsObjects_(ss.getSheetByName('UserRoles')).filter(function(r){
    return String(r.Role)==='SYSTEM_ADMIN'&&String(r.ScopeType)==='SYSTEM'&&String(r.ScopeID)==='*'&&String(r.Status).toUpperCase()==='ACTIVE';
  });
  var adminUsers=rowsAsObjects_(ss.getSheetByName('Users'));
  var validAdminCount=admins.filter(function(r){return adminUsers.some(function(u){return String(u.UserID)===String(r.UserID)&&String(u.Status).toUpperCase()==='ACTIVE';});}).length;
  report.checks.push({id:'ACTOR-01',status:validAdminCount>0?'PASS':'BLOCKED',detail:validAdminCount>0?'An active existing SYSTEM_ADMIN actor is available; its identifier is not logged.':'No active SYSTEM_ADMIN actor is available.'});

  var allPass=report.checks.every(function(x){return x.status==='PASS';});
  report.status=allPass?'READY':'BLOCKED';
  report.spreadsheetName=ss.getName();
  report.spreadsheetIdSuffix=ss.getId().slice(-6);
  report.summary={pass:report.checks.filter(function(x){return x.status==='PASS';}).length,blocked:report.checks.filter(function(x){return x.status!=='PASS';}).length};
  Logger.log('SNC_SYNTHETIC_FIXTURE_PREFLIGHT='+JSON.stringify(report));
  return report;
}

/**
 * Creates only the approved core fixture. This is a persistent write operation.
 * Run SNC_SyntheticFixturePreflight_TEST() first and inspect READY before calling.
 */
function SNC_CreateSyntheticCoreFixtures_TEST(confirmation) {
  if (String(confirmation||'')!==SNC_SFR_CONFIG_TEST.CONFIRMATION) {
    throw new Error('SAFETY_STOP: exact confirmation phrase is required.');
  }
  var gate=sncSFR_validateEnvironment_TEST_();
  if(!gate.ok)throw new Error('SAFETY_STOP: '+gate.reason);

  var lock=LockService.getDocumentLock();
  if(!lock)throw new Error('SAFETY_STOP: document lock is unavailable in this bound TEST project.');
  lock.waitLock(30000);
  try {
    var preflight=SNC_SyntheticFixturePreflight_TEST();
    if(preflight.status!=='READY')throw new Error('SAFETY_STOP: fixture preflight is not READY.');
    var ss=SpreadsheetApp.getActiveSpreadsheet();
    var actor=sncSFR_getSystemAdminActor_TEST_(ss);
    var manifest={
      version:SNC_SFR_CONFIG_TEST.VERSION,
      prefix:SNC_SFR_CONFIG_TEST.PREFIX,
      environment:'TEST',
      spreadsheetIdSuffix:ss.getId().slice(-6),
      createdAt:new Date().toISOString(),
      evidenceLevel:'HANDLER_LEVEL_INTEGRATION',
      actorType:'EXISTING_SYSTEM_ADMIN_CONTEXT',
      courseId:null,semesterId:null,offeringId:null,importJobId:null,
      studentIds:SNC_SFR_CONFIG_TEST.STUDENTS.map(function(x){return x.studentId;}),
      baselineIds:sncSFR_captureBaselineIds_TEST_(ss),
      userIds:[],enrollmentIds:[],
      stages:[],
      cleanupStatus:'NOT STARTED'
    };
    sncSFR_saveManifest_TEST_(manifest);

    var course=handleCourseManagementActionForActor_('course.create',actor,{
      courseCode:SNC_SFR_CONFIG_TEST.COURSE_CODE,
      courseName:'SNC Synthetic Integration Test Course',
      description:'Synthetic TEST fixture; do not use for teaching.'
    },Utilities.getUuid());
    manifest.courseId=String(course.CourseID);
    manifest.stages.push({stage:'COURSE_CREATED',status:'PASS'});
    sncSFR_saveManifest_TEST_(manifest);

    var semester=handleCourseManagementActionForActor_('semester.create',actor,{
      academicYear:SNC_SFR_CONFIG_TEST.ACADEMIC_YEAR,
      term:SNC_SFR_CONFIG_TEST.SEMESTER_TERM,
      startDate:SNC_SFR_CONFIG_TEST.START_DATE,
      endDate:SNC_SFR_CONFIG_TEST.END_DATE
    },Utilities.getUuid());
    manifest.semesterId=String(semester.SemesterID);
    manifest.stages.push({stage:'SEMESTER_CREATED',status:'PASS'});
    sncSFR_saveManifest_TEST_(manifest);

    var offering=handleCourseManagementActionForActor_('offering.create',actor,{
      courseId:manifest.courseId,
      semesterId:manifest.semesterId,
      section:'SNC_TEST'
    },Utilities.getUuid());
    manifest.offeringId=String(offering.OfferingID);
    manifest.stages.push({stage:'OFFERING_CREATED',status:'PASS'});
    sncSFR_saveManifest_TEST_(manifest);

    var rows=SNC_SFR_CONFIG_TEST.STUDENTS.map(function(x){
      return {studentId:x.studentId,firstName:x.firstName,lastName:x.lastName,email:x.email};
    });
    var preview=handleEnrollmentManagementAction_('import.preview',actor,{offeringId:manifest.offeringId,rows:rows},Utilities.getUuid());
    if(!preview||preview.validCount!==rows.length||preview.errorCount!==0) {
      throw new Error('FIXTURE_STOP: import preview did not validate all six synthetic students; no import execute was attempted.');
    }
    var imported=handleEnrollmentManagementAction_('import.execute',actor,{
      offeringId:manifest.offeringId,
      fileName:'SNC_SYNTHETIC_FIXTURE_BATCH',
      rows:rows
    },Utilities.getUuid());
    manifest.importJobId=String(imported.importJobId||'');
    manifest.stages.push({stage:'STUDENTS_IMPORTED_AND_ENROLLED',status:'PASS',count:Number(imported.successCount)||0});
    sncSFR_saveManifest_TEST_(manifest);

    var userRows=rowsAsObjects_(ss.getSheetByName('Users'));
    var enrollmentRows=rowsAsObjects_(ss.getSheetByName('Enrollments'));
    manifest.userIds=rows.map(function(x){
      var matches=userRows.filter(function(u){return String(u.StudentID)===x.studentId&&String(u.Email).toLowerCase()===x.email;});
      if(matches.length!==1)throw new Error('FIXTURE_RECONCILIATION_REQUIRED: synthetic user count is not exactly one.');
      return String(matches[0].UserID);
    });
    manifest.enrollmentIds=manifest.userIds.map(function(uid){
      var matches=enrollmentRows.filter(function(e){return String(e.OfferingID)===manifest.offeringId&&String(e.UserID)===uid&&String(e.Status).toUpperCase()==='ACTIVE';});
      if(matches.length!==1)throw new Error('FIXTURE_RECONCILIATION_REQUIRED: active enrollment count is not exactly one.');
      return String(matches[0].EnrollmentID);
    });
    manifest.stages.push({stage:'FIXTURE_ID_RECONCILIATION',status:'PASS',users:manifest.userIds.length,enrollments:manifest.enrollmentIds.length});
    manifest.completedAt=new Date().toISOString();
    manifest.status='CORE_FIXTURE_CREATED';
    sncSFR_saveManifest_TEST_(manifest);

    var safeReport={
      success:true,
      status:manifest.status,
      evidenceLevel:manifest.evidenceLevel,
      courseCreated:Boolean(manifest.courseId),
      semesterCreated:Boolean(manifest.semesterId),
      offeringCreated:Boolean(manifest.offeringId),
      studentsCreated:manifest.userIds.length,
      enrollmentsCreated:manifest.enrollmentIds.length,
      importJobCreated:Boolean(manifest.importJobId),
      manifestStoredInScriptProperties:true,
      cleanupStatus:manifest.cleanupStatus,
      note:'No group, assignment, submission, Drive, notification, trigger, LINE, or browser/LIFF tests were executed.'
    };
    Logger.log('SNC_SYNTHETIC_FIXTURE_CREATE='+JSON.stringify(safeReport));
    return {report:safeReport,manifest:manifest};
  } catch(e) {
    var props=PropertiesService.getScriptProperties();
    var raw=props.getProperty(SNC_SFR_CONFIG_TEST.MANIFEST_PROPERTY);
    if(raw) {
      try {
        var m=JSON.parse(raw);
        m.status='STOPPED_REQUIRES_RECONCILIATION';
        m.reconciledIds=sncSFR_captureNewIds_TEST_(SpreadsheetApp.getActiveSpreadsheet(),m.baselineIds||{});
        m.stopReason=String(e&&e.message||e).slice(0,240);
        m.stoppedAt=new Date().toISOString();
        sncSFR_saveManifest_TEST_(m);
      } catch(ignore) {}
    }
    Logger.log('SNC_SYNTHETIC_FIXTURE_CREATE_STOPPED='+JSON.stringify({status:'STOPPED_REQUIRES_RECONCILIATION',message:String(e&&e.message||e).slice(0,240),manifestStored:Boolean(raw)}));
    throw e;
  } finally {
    lock.releaseLock();
  }
}

/** Returns the exact manifest for owner-side private retention; no writes. */
function SNC_GetSyntheticFixtureManifest_TEST() {
  var gate=sncSFR_validateEnvironment_TEST_();
  if(!gate.ok)throw new Error('SAFETY_STOP: '+gate.reason);
  var raw=PropertiesService.getScriptProperties().getProperty(SNC_SFR_CONFIG_TEST.MANIFEST_PROPERTY);
  if(!raw)return {success:false,status:'NO_MANIFEST'};
  return JSON.parse(raw);
}

function sncSFR_validateEnvironment_TEST_() {
  var props=PropertiesService.getScriptProperties();
  var env=String(props.getProperty(SNC_SFR_CONFIG_TEST.ENVIRONMENT_PROPERTY)||'').trim().toUpperCase();
  var expected=String(props.getProperty(SNC_SFR_CONFIG_TEST.SPREADSHEET_PROPERTY)||'').trim();
  if(env!=='TEST')return {ok:false,reason:'SNC_ITR_ENVIRONMENT must be explicitly TEST.'};
  if(expected!==SNC_SFR_CONFIG_TEST.TEST_SPREADSHEET_ID)return {ok:false,reason:'Configured TEST spreadsheet ID does not match the approved ID.'};
  var ss=SpreadsheetApp.getActiveSpreadsheet();
  if(!ss)return {ok:false,reason:'No active spreadsheet is available.'};
  if(ss.getId()!==expected)return {ok:false,reason:'Active spreadsheet does not match the approved TEST spreadsheet ID.'};
  return {ok:true,spreadsheetName:ss.getName(),spreadsheetIdSuffix:ss.getId().slice(-6)};
}

function sncSFR_getSystemAdminActor_TEST_(ss) {
  var roles=rowsAsObjects_(ss.getSheetByName('UserRoles'));
  var users=rowsAsObjects_(ss.getSheetByName('Users'));
  var matches=roles.filter(function(r){
    return String(r.Role)==='SYSTEM_ADMIN'&&String(r.ScopeType)==='SYSTEM'&&String(r.ScopeID)==='*'&&String(r.Status).toUpperCase()==='ACTIVE';
  }).filter(function(r){
    return users.some(function(u){return String(u.UserID)===String(r.UserID)&&String(u.Status).toUpperCase()==='ACTIVE';});
  });
  if(!matches.length)throw new Error('SAFETY_STOP: no active SYSTEM_ADMIN actor is available.');
  var unique={};matches.forEach(function(r){unique[String(r.UserID)]=true;});
  var ids=Object.keys(unique);
  if(ids.length!==1)throw new Error('SAFETY_STOP: multiple active SYSTEM_ADMIN actors; explicit actor selection is required.');
  return {userId:ids[0],roles:[{role:'SYSTEM_ADMIN',scopeType:'SYSTEM',scopeId:'*'}]};
}

function sncSFR_saveManifest_TEST_(manifest) {
  PropertiesService.getScriptProperties().setProperty(
    SNC_SFR_CONFIG_TEST.MANIFEST_PROPERTY,
    JSON.stringify(manifest)
  );
}

/** Capture baseline primary keys before the first application-handler write. */
function sncSFR_captureBaselineIds_TEST_(ss) {
  var map={Courses:['CourseID'],Semesters:['SemesterID'],CourseOfferings:['OfferingID'],
    Users:['UserID'],Enrollments:['EnrollmentID'],ImportJobs:['ImportJobID']};
  var out={};
  Object.keys(map).forEach(function(name){
    var rows=rowsAsObjects_(ss.getSheetByName(name)),key=map[name][0];
    out[name]=rows.map(function(r){return String(r[key]||'');}).filter(Boolean);
  });
  return out;
}

/**
 * On an interrupted/failed handler, capture exact newly appearing IDs for manual
 * reconciliation. This does not delete or modify any record.
 */
function sncSFR_captureNewIds_TEST_(ss,baseline) {
  var map={Courses:'CourseID',Semesters:'SemesterID',CourseOfferings:'OfferingID',
    Users:'UserID',Enrollments:'EnrollmentID',ImportJobs:'ImportJobID'};
  var out={};
  Object.keys(map).forEach(function(name){
    var prior=baseline[name]||[];
    out[name]=rowsAsObjects_(ss.getSheetByName(name)).map(function(r){return String(r[map[name]]||'');})
      .filter(function(id){return id&&prior.indexOf(id)===-1;});
  });
  return out;
}
